<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Shogi Online' %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <% if (typeof currentPage !== 'undefined' && currentPage === 'lobby') { %>
        <link rel="stylesheet" href="/stylesheets/lobby-spectate.css">
    <% } %>
</head>
<body>
    <%- include('partials/sidebar', { 
        currentPage: typeof currentPage !== 'undefined' ? currentPage : 'lobby',
        userName: typeof userName !== 'undefined' ? userName : 'プレイヤー',
        userSchool: typeof userSchool !== 'undefined' ? userSchool : '',
        userGrade: typeof userGrade !== 'undefined' ? userGrade : '',
        userRating: typeof userRating !== 'undefined' ? userRating : '1500',
        todayGames: typeof todayGames !== 'undefined' ? todayGames : '0'
    }) %>
    
    <%- body %>
</body>
</html>
