<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>対局中 - KiNote</title>
    <link rel="stylesheet" href="/stylesheets/game.css">
</head>
<body>
    <div class="game-header">
        <a href="/lobby" class="back-button">← ロビーに戻る</a>
        <h2 style="margin: 0;">対局中</h2>
        <div class="header-spacer"></div>
    </div>
    
    <div id="spectator-banner" style="display: none;">
        👁️ 観戦モード - この対局を観戦中です
    </div>
    
    <div class="game-wrapper">
        <!-- 左側：相手エリア -->
        <div class="side-column left-side">
            <div id="<%= currentUserId === senteId ? 'gote' : 'sente' %>-timer-container" class="player-timer">
                <div id="<%= currentUserId === senteId ? 'gote' : 'sente' %>-timer" class="timer-value">--:--</div>
            </div>
            <div class="captured-section">
                <div id="left-pieces" class="captured-grid"></div>
            </div>
        </div>

        <!-- 中央：将棋盤 -->
        <div class="board-container">
            <table id="board"></table>
        </div>

        <!-- 右側：自分エリア -->
        <div class="side-column right-side">
            <div id="<%= currentUserId === senteId ? 'sente' : 'gote' %>-timer-container" class="player-timer">
                <div id="<%= currentUserId === senteId ? 'sente' : 'gote' %>-timer" class="timer-value">--:--</div>
            </div>
            <div class="captured-section">
                <div id="right-pieces" class="captured-grid"></div>
            </div>
        </div>
    </div>

    <!-- コントロール -->
    <div id="controls">
        <button id="cancelBtn" style="<%= (currentUserId !== senteId && currentUserId !== goteId) ? 'display: none;' : '' %>">選択解除</button>
        <button id="resignBtn" class="resign-btn" style="<%= (currentUserId !== senteId && currentUserId !== goteId) ? 'display: none;' : '' %>">投了</button>
    </div>
    
    <div id="status">Loading…</div>
    
    <!-- 成り確認モーダル -->
    <div id="promote-modal">
        <div id="promote-dialog">
            <h3>成りますか？</h3>
            <button id="promoteYes">成る</button>
            <button id="promoteNo">成らない</button>
        </div>
    </div>

    <script>
        const gameId = '<%= gameId %>';
        const currentUserId = '<%= userId %>';
        const senteId = '<%= senteId %>';
        const goteId = '<%= goteId %>';
    </script>
    <script src="/javascripts/game-client.js"></script>
</body>
</html>