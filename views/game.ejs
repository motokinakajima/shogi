<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Shogi Game</title>
    <link rel="stylesheet" href="/stylesheets/game.css">
</head>
<body>
    <div id="spectator-banner" style="display: none;">
        👁️ 観戦モード - この対局を観戦中です
    </div>
    <div id="controls">
        <button id="cancelBtn">Cancel Selection</button>
        <button id="resignBtn" class="resign-btn">投了</button>
    </div>
    
    <div id="timer-display">
        <div class="player-timer" id="gote-timer-container">
            <span class="timer-label">後手</span>
            <span id="gote-timer" class="timer-value">10:00</span>
        </div>
        <div class="player-timer" id="sente-timer-container">
            <span class="timer-label">先手</span>
            <span id="sente-timer" class="timer-value">10:00</span>
        </div>
    </div>

    <div id="game-container">
        <div class="captured-section" id="left-captured">
            <h4 id="left-label">後手 持ち駒</h4>
            <div id="left-pieces"></div>
        </div>
        <table id="board"></table>
        <div class="captured-section" id="right-captured">
            <h4 id="right-label">先手 持ち駒</h4>
            <div id="right-pieces"></div>
        </div>
    </div>
    
    <div id="promote-modal">
        <div id="promote-dialog">
            <h3>成りますか？</h3>
            <button id="promoteYes">成る</button>
            <button id="promoteNo">成らない</button>
        </div>
    </div>
    
    <div id="status">Loading…</div>

    <script>
        // Pass EJS variables to game-client.js
        const gameId = '<%= gameId %>';
        const currentUserId = '<%= userId %>';
        const senteId = '<%= senteId %>';
        const goteId = '<%= goteId %>';
    </script>
    <script src="/javascripts/game-client.js"></script>

    </script>
</body>
</html>