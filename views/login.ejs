<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ログイン - KiNote</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: "Hiragino Mincho ProN", "Yu Mincho", "MS Mincho", serif;
            background: #4D5D70;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container {
            background: white;
            padding: 0;
            border: 1px solid #000000;
            width: 400px;
        }
        .header {
            background: #4D5D70;
            padding: 20px 30px;
            color: #FFE498;
            font-size: 32px;
            letter-spacing: 2px;
        }
        .form-body {
            padding: 30px;
        }
        h1 {
            font-size: 24px;
            font-weight: 400;
            margin-bottom: 24px;
            color: #333;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-size: 16px;
        }
        input {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            border: 1px solid #000000;
            font-family: inherit;
        }
        button {
            width: 100%;
            padding: 14px;
            font-size: 18px;
            background: #4D5D70;
            color: white;
            border: 2px solid #4D5D70;
            border-radius: 10px;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.2s;
            margin-top: 10px;
        }
        button:hover {
            background: #3a4a5a;
        }
        .links {
            margin-top: 24px;
            line-height: 2;
            font-size: 14px;
            color: #666;
        }
        .links a {
            color: #4D5D70;
            text-decoration: none;
        }
        .links a:hover {
            text-decoration: underline;
        }
        .success-message {
            background: #e8f5e9;
            color: #2e7d32;
            padding: 12px;
            margin-bottom: 20px;
            border-left: 3px solid #4caf50;
            font-size: 14px;
        }
        .error-message {
            background: #ffebee;
            color: #c62828;
            padding: 12px;
            margin-bottom: 20px;
            border-left: 3px solid #f44336;
            font-size: 14px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">KiNote</div>
        <div class="form-body">
            <h1>ログイン</h1>
            <div id="success-message" class="success-message" style="display: none;"></div>
            <div id="error-message" class="error-message"></div>
            <form id="login-form" action="/login" method="POST">
                <div class="form-group">
                    <label for="email">メールアドレス</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="password">パスワード</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button type="submit">ログイン</button>
            </form>
            <div class="links">
                学校別メンバー管理の方は、<a href="/login/school">こちら</a><br>
                新規登録の方は、<a href="/login/register">こちら</a><br>
                パスワードをお忘れの方は、<a href="/login/forgot-password">こちら</a>
            </div>
        </div>
    </div>
    <script>
        // URLパラメータから成功メッセージを表示
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('reset') === 'success') {
            const messageDiv = document.getElementById('success-message');
            messageDiv.textContent = '✓ パスワードが正常に更新されました。新しいパスワードでログインしてください。';
            messageDiv.style.display = 'block';
            
            // URLをクリーンにする
            window.history.replaceState({}, document.title, '/login');
        
        // ログインフォーム送信処理
        document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const errorDiv = document.getElementById('error-message');
            const submitButton = e.target.querySelector('button[type="submit"]');
            
            // エラーメッセージをクリア
            errorDiv.style.display = 'none';
            submitButton.disabled = true;
            submitButton.textContent = 'ログイン中...';
            
            try {
                const response = await fetch('/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    // ログイン成功 - リダイレクト
                    window.location.href = '/lobby';
                } else {
                    // エラー表示
                    errorDiv.textContent = data.error || 'ログインに失敗しました';
                    errorDiv.style.display = 'block';
                    submitButton.disabled = false;
                    submitButton.textContent = 'ログイン';
                }
            } catch (error) {
                errorDiv.textContent = 'ネットワークエラーが発生しました';
                errorDiv.style.display = 'block';
                submitButton.disabled = false;
                submitButton.textContent = 'ログイン';
            }
        });
        }
    </script>
</body>
</html>