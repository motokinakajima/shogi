<!DOCTYPE html>
<html>
<head>
    <style>
        #shogi-board {
            border-collapse: collapse;
            margin: 20px auto;
            border: 3px solid #000;
        }
        #shogi-board td {
            width: 50px;
            height: 50px;
            border: 1px solid #000;
            background: #deb887;
            text-align: center;
            vertical-align: middle;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
        }
        #shogi-board td:hover {
            background: #f4a460;
        }
        
        /* Piece styling */
        .piece.player-1 {
            color: #000;
        }
        
        .piece.player-2 {
            color: #c41e3a;
        }
        
        .piece.promoted {
            text-decoration: underline;
        }
        
        .selected {
            background: #ff6b6b !important;
        }
        
        .possible-move {
            background: #4ecdc4 !important;
        }
        
        .possible-drop {
            background: #90EE90 !important;
            border: 2px dashed #228B22 !important;
        }
        
        /* Captured pieces styling */
        .captured-piece-clickable {
            padding: 2px 4px;
            margin: 2px;
            border-radius: 3px;
            transition: background-color 0.2s;
        }
        
        .captured-piece-clickable:hover {
            background: #f4a460;
        }
        
        .captured-piece-clickable.selected {
            background: #4ecdc4 !important;
            color: white;
        }
        
        /* Captured pieces area */
        .captured-pieces {
            display: flex;
            justify-content: space-between;
            margin: 20px;
        }
        
        .player-captured {
            border: 2px solid #000;
            padding: 10px;
            min-height: 60px;
        }
        
        /* Piece palette styling */
        .palette-piece {
            display: inline-block;
            width: 40px;
            height: 40px;
            border: 2px solid #000;
            background: #deb887;
            text-align: center;
            line-height: 36px;
            margin: 2px;
            cursor: pointer;
            font-size: 18px;
            font-weight: bold;
        }
        
        .palette-piece:hover {
            background: #f4a460;
        }
        
        .palette-piece.selected {
            background: #4ecdc4 !important;
            border-color: #2c9aa0;
        }
        
        .palette-piece[data-player="1"] {
            color: #000;
        }
        
        .palette-piece[data-player="2"] {
            color: #c41e3a;
        }
        
        .piece-row {
            margin: 5px 0;
        }
        
        .setup-mode-active .board-cell {
            border-color: #4ecdc4 !important;
        }
    </style>
</head>
<body>

    <table id="shogi-board">
        <tr>
            <td id="cell-0-0"></td><td id="cell-1-0"></td><td id="cell-2-0"></td><td id="cell-3-0"></td><td id="cell-4-0"></td><td id="cell-5-0"></td><td id="cell-6-0"></td><td id="cell-7-0"></td><td id="cell-8-0"></td>
        </tr>
        <tr>
            <td id="cell-0-1"></td><td id="cell-1-1"></td><td id="cell-2-1"></td><td id="cell-3-1"></td><td id="cell-4-1"></td><td id="cell-5-1"></td><td id="cell-6-1"></td><td id="cell-7-1"></td><td id="cell-8-1"></td>
        </tr>
        <tr>
            <td id="cell-0-2"></td><td id="cell-1-2"></td><td id="cell-2-2"></td><td id="cell-3-2"></td><td id="cell-4-2"></td><td id="cell-5-2"></td><td id="cell-6-2"></td><td id="cell-7-2"></td><td id="cell-8-2"></td>
        </tr>
        <tr>
            <td id="cell-0-3"></td><td id="cell-1-3"></td><td id="cell-2-3"></td><td id="cell-3-3"></td><td id="cell-4-3"></td><td id="cell-5-3"></td><td id="cell-6-3"></td><td id="cell-7-3"></td><td id="cell-8-3"></td>
        </tr>
        <tr>
            <td id="cell-0-4"></td><td id="cell-1-4"></td><td id="cell-2-4"></td><td id="cell-3-4"></td><td id="cell-4-4"></td><td id="cell-5-4"></td><td id="cell-6-4"></td><td id="cell-7-4"></td><td id="cell-8-4"></td>
        </tr>
        <tr>
            <td id="cell-0-5"></td><td id="cell-1-5"></td><td id="cell-2-5"></td><td id="cell-3-5"></td><td id="cell-4-5"></td><td id="cell-5-5"></td><td id="cell-6-5"></td><td id="cell-7-5"></td><td id="cell-8-5"></td>
        </tr>
        <tr>
            <td id="cell-0-6"></td><td id="cell-1-6"></td><td id="cell-2-6"></td><td id="cell-3-6"></td><td id="cell-4-6"></td><td id="cell-5-6"></td><td id="cell-6-6"></td><td id="cell-7-6"></td><td id="cell-8-6"></td>
        </tr>
        <tr>
            <td id="cell-0-7"></td><td id="cell-1-7"></td><td id="cell-2-7"></td><td id="cell-3-7"></td><td id="cell-4-7"></td><td id="cell-5-7"></td><td id="cell-6-7"></td><td id="cell-7-7"></td><td id="cell-8-7"></td>
        </tr>
        <tr>
            <td id="cell-0-8"></td><td id="cell-1-8"></td><td id="cell-2-8"></td><td id="cell-3-8"></td><td id="cell-4-8"></td><td id="cell-5-8"></td><td id="cell-6-8"></td><td id="cell-7-8"></td><td id="cell-8-8"></td>
        </tr>
    </table>

    <!-- Captured pieces display -->
    <div class="captured-pieces">
        <div class="player-captured" id="player1-captured">
            <h3>Player 1 Captured</h3>
            <div id="player1-pieces"></div>
        </div>
        <div class="player-captured" id="player2-captured">
            <h3>Player 2 Captured</h3>
            <div id="player2-pieces"></div>
        </div>
    </div>

    <!-- Game controls -->
    <div style="text-align: center; margin: 20px;">
        <button id="flip-board">Flip Board</button>
        <button id="reset-game">Reset Game</button>
        <button id="toggle-setup-mode">Setup Mode</button>
        <button id="clear-board">Clear Board</button>
        <div id="game-status">Current Player: <span id="current-player">1</span></div>
        <div id="setup-status" style="display: none; color: #c41e3a; font-weight: bold;">
            Setup Mode Active - Click pieces to place them
        </div>
    </div>

    <!-- Piece palette for setup mode -->
    <div id="piece-palette" style="display: none; text-align: center; margin: 20px; border: 2px solid #000; padding: 15px;">
        <h3>Piece Palette - Click to select, then click board to place</h3>
        <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
            <div class="piece-selection">
                <h4>Player 1 (Black)</h4>
                <div class="piece-row">
                    <span class="palette-piece" data-piece="FU" data-player="1">歩</span>
                    <span class="palette-piece" data-piece="KY" data-player="1">香</span>
                    <span class="palette-piece" data-piece="KE" data-player="1">桂</span>
                    <span class="palette-piece" data-piece="GI" data-player="1">銀</span>
                    <span class="palette-piece" data-piece="KI" data-player="1">金</span>
                    <span class="palette-piece" data-piece="HI" data-player="1">飛</span>
                    <span class="palette-piece" data-piece="KA" data-player="1">角</span>
                    <span class="palette-piece" data-piece="OU" data-player="1">王</span>
                </div>
            </div>
            <div class="piece-selection">
                <h4>Player 2 (Red)</h4>
                <div class="piece-row">
                    <span class="palette-piece" data-piece="FU" data-player="2">歩</span>
                    <span class="palette-piece" data-piece="KY" data-player="2">香</span>
                    <span class="palette-piece" data-piece="KE" data-player="2">桂</span>
                    <span class="palette-piece" data-piece="GI" data-player="2">銀</span>
                    <span class="palette-piece" data-piece="KI" data-player="2">金</span>
                    <span class="palette-piece" data-piece="HI" data-player="2">飛</span>
                    <span class="palette-piece" data-piece="KA" data-player="2">角</span>
                    <span class="palette-piece" data-piece="OU" data-player="2">王</span>
                </div>
            </div>
            <div class="piece-selection">
                <h4>Remove</h4>
                <span class="palette-piece" data-piece="REMOVE" data-player="0" style="background: #ff6b6b;">✗</span>
            </div>
        </div>
        <div id="selected-piece-display" style="margin-top: 10px; font-weight: bold;"></div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/socket-client.js"></script>
    <script src="/javascripts/shogi-pieces.js"></script>
    <script src="/javascripts/shogi-board-class.js"></script>
    <script src="/javascripts/shogi-board.js"></script>
</body>
</html>

