<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>パスワード変更 - KiNote</title>
    <link rel="stylesheet" href="/stylesheets/auth.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">KiNote</div>
        </div>
        <div class="form-body">
            <h2>学校管理者<br>パスワード変更</h2>
            <form action="/login/school-password-reset" method="POST">
                <div class="form-group">
                    <label for="school">学校名</label>
                    <select id="school" name="school" required>
                        <option value="" disabled selected>学校を選択してください</option>
                        <%for (const school of schools) { %>
                            <option value="<%= school.id %>"><%= school.display_name %></option>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="password">新しいパスワード</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button type="submit" class="btn btn-primary">変更する</button>
            </form>
            <div class="links">
                <a href="/school-admin/login">学校管理者ログインに戻る</a>
            </div>
        </div>
    </div>
</body>
</html>