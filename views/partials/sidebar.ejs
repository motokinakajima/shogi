<aside class="sidebar">
    <div>
        <div class="siteTitle">
            <h1>KiNote</h1>
        </div>
        
        <nav class="links">
            <a href="/lobby" class="<%= currentPage === 'lobby' ? 'active' : '' %>">
                トップ
            </a>
            <a href="/mypage" class="<%= currentPage === 'mypage' ? 'active' : '' %>">
                マイページ
            </a>
            <a href="/database" class="<%= currentPage === 'database' ? 'active' : '' %>">
                データベース
            </a>
            <a href="/rankings" class="<%= currentPage === 'rankings' ? 'active' : '' %>">
                ランキング
            </a>
            <a href="/contact" class="<%= currentPage === 'contact' ? 'active' : '' %>">
                お問い合わせ
            </a>
        </nav>
    </div>
    
    <div class="userInfo">
        <div class="profile">
            <div class="name">
                <p><%= userName || 'プレイヤー' %> さん</p>
            </div>
            <div class="sub">
                <span><%= userGrade || '' %></span>
                <span><%= userSchool ? '/ ' + userSchool : '' %></span>
            </div>
        </div>
        <div class="status">
            <div class="rate">（レート）<%= userRating || '1500' %></div>
            <div class="today">（本日）<%= todayGames || '0' %>局</div>
        </div>
        <div class="logout">
            <form action="/login/logout" method="POST">
                <button type="submit">ログアウト</button>
            </form>
        </div>
    </div>
</aside>
