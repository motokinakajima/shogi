<aside class="sidebar">
    <div>
        <div class="siteTitle">
            <h1>将棋オンライン</h1>
        </div>
        
        <nav class="links">
            <a href="/lobby" class="<%= currentPage === 'lobby' ? 'active' : '' %>">
                🎮 ロビー
            </a>
            <a href="/mypage" class="<%= currentPage === 'mypage' ? 'active' : '' %>">
                👤 マイページ
            </a>
            <a href="/database" class="<%= currentPage === 'database' ? 'active' : '' %>">
                📊 棋譜データベース
            </a>
            <a href="/rankings" class="<%= currentPage === 'rankings' ? 'active' : '' %>">
                🏆 ランキング
            </a>
        </nav>
    </div>
    
    <div class="userInfo">
        <div class="profile">
            <div class="name">
                <p><%= userName || 'プレイヤー' %></p>
            </div>
            <div class="sub">
                <span><%= userSchool || '学校未設定' %></span>
                <span><%= userGrade || '学年未設定' %></span>
            </div>
        </div>
        <div class="status">
            <div class="rate"><%= userRating || '1500' %></div>
            <div class="today">今日: <%= todayGames || '0' %>局</div>
        </div>
        <div class="logout">
            <form action="/login/logout" method="POST">
                <button type="submit">ログアウト</button>
            </form>
        </div>
    </div>
</aside>
