<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>学校管理者ログイン - KiNote</title>
    <link rel="stylesheet" href="/stylesheets/auth.css">
</head>
<body>
    <div class="container">
        <div class="header">KiNote</div>
        <div class="form-body">
            <h1>学校管理者ログイン</h1>
            <p class="subtitle">学校のメンバーを管理する管理者の方はこちら</p>
            <form action="/login/school" method="POST">
                <div class="form-group">
                    <label for="school">学校名</label>
                    <select id="school" name="school" required>
                        <option value="" disabled selected>学校を選択してください</option>
                        <% for (const school of schools) { %>
                            <option value="<%= school.id %>"><%= school.display_name %></option>
                        <% } %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="password">管理者パスワード</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button type="submit" class="btn btn-primary">ログイン</button>
            </form>
            <div class="links">
                <a href="/login">← 一般ユーザーログインに戻る</a>
            </div>
        </div>
    </div>
</body>
</html>