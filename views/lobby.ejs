<div class="page">
    <div class="description">
        <h1>★ 現在のオンラインユーザー</h1>
        <p>対戦したいユーザーを選んで申し込みましょう</p>
    </div>

    <table class="list">
        <thead>
            <tr>
                <th class="name">表示名</th>
                <th class="school">学校</th>
                <th class="grade">学年</th>
                <th>棋力</th>
                <th class="rate">レート</th>
                <th class="requestType">受付設定</th>
                <th>アクション</th>
            </tr>
        </thead>
        <tbody id="online-users"></tbody>
    </table>

    <div class="actions">
        <div class="receiving">
            <h3>受け付ける対局の時間設定</h3>
            <div class="time-presets">
                <button class="preset-btn" onclick="setMyTimePreset('blitz1')">1+30秒</button>
                <button class="preset-btn active" onclick="setMyTimePreset('rapid10')">10分切れ負け</button>
                <button class="preset-btn" onclick="setMyTimePreset('rapid10b30')">10+30秒</button>
                <button class="preset-btn" onclick="setMyTimePreset('classical30')">30分切れ負け</button>
            </div>
        </div>
    </div>
    
    <div class="spectate-section">
        <h2>★ 現在の対局一覧</h2>
        <p class="spectate-description">進行中の対局を観戦できます</p>
        <div id="active-games-list" class="active-games-list">
            <p style="text-align: center; color: #666;">読み込み中...</p>
        </div>
    </div>
</div>

<div id="challenge-modal" class="modal">
    <div class="modal-content">
        <h3 id="challenger-name">Challenger Name</h3>
        <div id="challenge-queue"></div>
        <div class="modal-buttons">
            <button class="modal-btn accept-btn" onclick="acceptCurrentChallenge()">受ける</button>
            <button class="modal-btn decline-btn" onclick="declineCurrentChallenge()">断る</button>
        </div>
    </div>
</div>

<div id="waiting-modal" class="modal">
    <div class="modal-content">
        <h3>対戦申込中</h3>
        <div id="pending-list"></div>
    </div>
</div>

<script>
    const currentUserId = '<%= currentUserId %>';
    const currentUserName = '<%= currentUserName %>';
    const wsUrl = '<%= wsUrl %>';
    
    const ws = new WebSocket(wsUrl);
    const tbody = document.getElementById('online-users');
    const modal = document.getElementById('challenge-modal');
    const waitingModal = document.getElementById('waiting-modal');
    const challengerNameEl = document.getElementById('challenger-name');
    const challengeQueueEl = document.getElementById('challenge-queue');
    const pendingListEl = document.getElementById('pending-list');

    const onlineUserIds = new Set();
    const userCache = new Map();
    const userTimeSettings = new Map(); // userId -> timeConfig
    const incomingChallenges = [];
    const outgoingChallenges = new Map();
    
    let myTimeConfig = {
        preset: 'rapid10',
        mode: 'sudden_death',
        initialTime: 600000, // 10分
        byoyomiTime: 30000,
        fischerIncrement: 0
    };

    ws.onopen = () => {
        // WebSocket接続成功
    };
    
    ws.onerror = (error) => {
        console.error('WebSocket error:', error);
    };
    
    ws.onclose = (event) => {
        console.warn('WebSocket closed:', event.code);
    };

    ws.onmessage = async (e) => {
        const msg = JSON.parse(e.data);
        
        if (msg.type === 'lobby:ready') {
            // サーバー準備完了、自分の時間設定を送信
            ws.send(JSON.stringify({
                type: 'settings:update',
                timeConfig: myTimeConfig
            }));
        }

        if (msg.type === 'lobby:update') {
            const newIds = new Set(msg.users);
            const added = [...newIds].filter(id => !onlineUserIds.has(id));
            const removed = [...onlineUserIds].filter(id => !newIds.has(id));

            onlineUserIds.clear();
            newIds.forEach(id => onlineUserIds.add(id));

            if (added.length > 0) {
                const res = await fetch('/api/users/by-ids', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: added })
                });
                const users = await res.json();
                for (const user of users) {
                    userCache.set(user.id, user);
                }
            }

            removed.forEach(id => {
                userCache.delete(id);
                userTimeSettings.delete(id);
            });
            renderTable();
        }
        
        if (msg.type === 'settings:update') {
            userTimeSettings.set(msg.userId, msg.timeConfig);
            renderTable();
        }

        if (msg.type === 'challenge:received') {
            incomingChallenges.push({
                challengeId: msg.challengeId,
                fromUserId: msg.fromUserId,
                fromDisplayName: msg.fromDisplayName
            });
            updateChallengeModal();
        }

        if (msg.type === 'challenge:sent') {
            const targetUser = userCache.get(msg.targetUserId);
            outgoingChallenges.set(msg.challengeId, {
                targetUserId: msg.targetUserId,
                targetName: targetUser?.display_name || 'Unknown'
            });
            updateWaitingModal();
        }

        if (msg.type === 'game:start') {
            window.location.href = `/game/${msg.gameId}`;
        }

        if (msg.type === 'challenge:declined') {
            outgoingChallenges.delete(msg.challengeId);
            updateWaitingModal();
        }

        if (msg.type === 'challenge:cancelled') {
            const index = incomingChallenges.findIndex(c => c.challengeId === msg.challengeId);
            if (index !== -1) {
                incomingChallenges.splice(index, 1);
                updateChallengeModal();
            }
        }

        if (msg.type === 'challenge:expired') {
            outgoingChallenges.delete(msg.challengeId);
            const index = incomingChallenges.findIndex(c => c.challengeId === msg.challengeId);
            if (index !== -1) incomingChallenges.splice(index, 1);
            updateWaitingModal();
            updateChallengeModal();
        }
    };

    ws.onclose = () => {
        console.log('disconnected');
    };

    function renderTable() {
        tbody.innerHTML = '';
        for (const id of onlineUserIds) {
            const user = userCache.get(id);
            const timeConfig = userTimeSettings.get(id);
            const tr = document.createElement('tr');

            const tdName = document.createElement('td');
            tdName.textContent = user ? user.display_name : '(loading...)';

            const tdSchool = document.createElement('td');
            tdSchool.textContent = user?.school_name || '-';

            const tdGrade = document.createElement('td');
            tdGrade.textContent = user?.grade || '-';

            const tdSkill = document.createElement('td');
            tdSkill.textContent = user?.skill_level || '-';

            const tdRating = document.createElement('td');
            tdRating.textContent = user?.rating || '1500';
            
            const tdTimeSetting = document.createElement('td');
            if (timeConfig) {
                const badge = document.createElement('span');
                badge.className = 'time-badge';
                badge.textContent = getTimePresetLabel(timeConfig.preset);
                tdTimeSetting.appendChild(badge);
            } else {
                tdTimeSetting.textContent = '-';
            }

            const tdAction = document.createElement('td');
            if (id !== currentUserId) {
                const challengeBtn = document.createElement('button');
                challengeBtn.className = 'challenge-btn';
                challengeBtn.textContent = '対戦申込';
                challengeBtn.onclick = () => sendChallenge(id);
                tdAction.appendChild(challengeBtn);
            } else {
                tdAction.textContent = '(あなた)';
            }

            tr.appendChild(tdName);
            tr.appendChild(tdSchool);
            tr.appendChild(tdGrade);
            tr.appendChild(tdSkill);
            tr.appendChild(tdRating);
            tr.appendChild(tdTimeSetting);
            tr.appendChild(tdAction);
            tbody.appendChild(tr);
        }
    }
    
    function getTimePresetLabel(preset) {
        const labels = {
            'blitz1': '1+30秒',
            'rapid10': '10分切れ負け',
            'rapid10b30': '10+30秒',
            'classical30': '30分切れ負け'
        };
        return labels[preset] || preset;
    }

    function sendChallenge(targetUserId) {
        const targetTimeConfig = userTimeSettings.get(targetUserId);
        ws.send(JSON.stringify({
            type: 'challenge:send',
            targetUserId,
            timeConfig: targetTimeConfig || myTimeConfig
        }));
    }
    
    function setMyTimePreset(preset) {
        document.querySelectorAll('.my-settings .preset-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');
        
        const presets = {
            'blitz1': { preset: 'blitz1', mode: 'byoyomi', initialTime: 60000, byoyomiTime: 30000, fischerIncrement: 0 },
            'rapid10': { preset: 'rapid10', mode: 'sudden_death', initialTime: 600000, byoyomiTime: 30000, fischerIncrement: 0 },
            'rapid10b30': { preset: 'rapid10b30', mode: 'byoyomi', initialTime: 600000, byoyomiTime: 30000, fischerIncrement: 0 },
            'classical30': { preset: 'classical30', mode: 'sudden_death', initialTime: 1800000, byoyomiTime: 30000, fischerIncrement: 0 }
        };
        
        myTimeConfig = presets[preset] || myTimeConfig;
        
        // サーバーに更新を送信
        ws.send(JSON.stringify({
            type: 'settings:update',
            timeConfig: myTimeConfig
        }));
    }

    function acceptCurrentChallenge() {
        if (incomingChallenges.length === 0) return;
        const challenge = incomingChallenges.shift();
        ws.send(JSON.stringify({
            type: 'challenge:accept',
            challengeId: challenge.challengeId
        }));
        updateChallengeModal();
    }

    function declineCurrentChallenge() {
        if (incomingChallenges.length === 0) return;
        const challenge = incomingChallenges.shift();
        ws.send(JSON.stringify({
            type: 'challenge:decline',
            challengeId: challenge.challengeId
        }));
        updateChallengeModal();
    }

    function cancelOutgoingChallenge(challengeId) {
        ws.send(JSON.stringify({
            type: 'challenge:cancel',
            challengeId
        }));
        outgoingChallenges.delete(challengeId);
        updateWaitingModal();
    }

    function updateChallengeModal() {
        if (incomingChallenges.length === 0) {
            modal.style.display = 'none';
            return;
        }

        const current = incomingChallenges[0];
        challengerNameEl.textContent = `${current.fromDisplayName} から対戦申込！`;
        
        if (incomingChallenges.length > 1) {
            challengeQueueEl.textContent = `(他 ${incomingChallenges.length - 1} 件)`;
        } else {
            challengeQueueEl.textContent = '';
        }
        
        modal.style.display = 'block';
    }

    function updateWaitingModal() {
        if (outgoingChallenges.size === 0) {
            waitingModal.style.display = 'none';
            return;
        }

        pendingListEl.innerHTML = '';
        for (const [challengeId, challenge] of outgoingChallenges.entries()) {
            const div = document.createElement('div');
            div.innerHTML = `
                <span>${challenge.targetName} に申込中...</span>
                <button class="modal-btn decline-btn" onclick="cancelOutgoingChallenge('${challengeId}')">キャンセル</button>
            `;
            pendingListEl.appendChild(div);
        }
        
        waitingModal.style.display = 'block';
    }
    
    // 進行中のゲーム一覧を取得
    async function loadActiveGames() {
        try {
            const res = await fetch('/api/active-games?limit=10');
            const data = await res.json();
            
            const listEl = document.getElementById('active-games-list');
            
            if (!data.games || data.games.length === 0) {
                listEl.innerHTML = '<p style="text-align: center; color: #7f8c8d;">現在進行中の対局はありません</p>';
                return;
            }
            
            listEl.innerHTML = data.games.map(game => `
                <div class="game-card" onclick="window.location.href='/game/${game.id}'">
                    <div class="game-players">
                        <div class="player">
                            <span class="player-name">${game.senteName}</span>
                            <span class="player-rating">(${game.senteRating})</span>
                        </div>
                        <span class="vs">vs</span>
                        <div class="player">
                            <span class="player-name">${game.goteName}</span>
                            <span class="player-rating">(${game.goteRating})</span>
                        </div>
                    </div>
                    <div class="game-info">
                        <span>${game.moveCount}手目</span>
                        <span class="turn-indicator">${game.currentTurn === 'sente' ? '▲先手番' : '△後手番'}</span>
                    </div>
                </div>
            `).join('');
        } catch (error) {
            console.error('Failed to load active games:', error);
        }
    }
    
    // 初回ロードと定期更新
    loadActiveGames();
    setInterval(loadActiveGames, 5000); // 5秒ごとに更新
</script>
