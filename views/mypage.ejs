<div class="page">
    <div class="description">
        <h1>マイページ</h1>
        <p>あなたのプロフィールと対局履歴</p>
    </div>

    <div class="stats-grid">
    <div class="stat-card">
        <h3>レーティング</h3>
        <div class="value"><%= user?.rating || 1500 %></div>
    </div>
    <div class="stat-card">
        <h3>総対局数</h3>
        <div class="value"><%= gameHistory.length %></div>
    </div>
    <div class="stat-card">
        <h3>メールアドレス</h3>
        <div class="value" style="font-size: 16px; color: #7f8c8d; font-weight: normal;">
            <%= user?.email_address %>
        </div>
    </div>
</div>

<div class="section">
    <h2>最近の対局</h2>
    <% if (gameHistory.length === 0) { %>
        <p style="color: #7f8c8d;">まだ対局履歴がありません</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>日時</th>
                    <th>結果</th>
                    <th>終局理由</th>
                </tr>
            </thead>
            <tbody>
                <% gameHistory.forEach(game => { %>
                    <tr style="cursor: pointer;" onclick="location.href='/kifu/<%= game.id %>'">
                        <td><%= new Date(game.created_at).toLocaleDateString('ja-JP') %></td>
                        <td><%= game.winner === 'sente' ? '先手勝ち' : '後手勝ち' %></td>
                        <td><%= game.finish_reason === 'checkmate' ? '詰み' : game.finish_reason %></td>
                        <td><a href="/kifu/<%= game.id %>" style="color: #3498db; text-decoration: none;">棋譜を見る →</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<div class="section">
    <h2>レート履歴</h2>
    <% if (ratingHistory.length === 0) { %>
        <p style="color: #7f8c8d;">まだレート変動がありません</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>日時</th>
                    <th>前</th>
                    <th>後</th>
                    <th>変動</th>
                </tr>
            </thead>
            <tbody>
                <% ratingHistory.forEach(record => { %>
                    <tr>
                        <td><%= new Date(record.created_at).toLocaleDateString('ja-JP') %></td>
                        <td><%= record.rating_before %></td>
                        <td><%= record.rating_after %></td>
                        <td style="color: <%= record.rating_after > record.rating_before ? '#27ae60' : '#e74c3c' %>">
                            <%= record.rating_after > record.rating_before ? '+' : '' %><%= record.rating_after - record.rating_before %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>
