<style>
    .rankings-container {
        background: white;
        border-radius: 8px;
        overflow: hidden;
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
    }
    
    table th, table td {
        padding: 15px;
        text-align: left;
    }
    
    table th {
        background: #34495e;
        color: white;
        font-weight: 600;
    }
    
    table tr:nth-child(even) {
        background: #f8f9fa;
    }
    
    .rank {
        font-weight: bold;
        color: #2c3e50;
        font-size: 18px;
    }
    
    .rank-1 { color: #f39c12; }
    .rank-2 { color: #95a5a6; }
    .rank-3 { color: #cd7f32; }
    
    .rating-value {
        font-weight: 600;
        color: #3498db;
    }
</style>

<p style="margin-bottom: 20px; color: #7f8c8d;">
    レーティング上位100名のランキング
</p>

<div class="rankings-container">
    <table>
        <thead>
            <tr>
                <th style="width: 80px;">順位</th>
                <th>プレイヤー</th>
                <th style="width: 120px;">レーティング</th>
            </tr>
        </thead>
        <tbody>
            <% rankings.forEach((player, index) => { %>
                <tr>
                    <td class="rank rank-<%= index + 1 %>"><%= index + 1 %></td>
                    <td><%= player.display_name %></td>
                    <td class="rating-value"><%= player.rating %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
