<div class="page">
    <div class="description">
        <h1>ランキング</h1>
        <p>レーティング上位100名のランキング</p>
    </div>

    <div class="rankings-container">
    <table>
        <thead>
            <tr>
                <th style="width: 80px;">順位</th>
                <th>プレイヤー</th>
                <th style="width: 120px;">レーティング</th>
            </tr>
        </thead>
        <tbody>
            <% rankings.forEach((player, index) => { %>
                <tr>
                    <td class="rank rank-<%= index + 1 %>"><%= index + 1 %></td>
                    <td><%= player.display_name %></td>
                    <td class="rating-value"><%= player.rating %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    </div>
</div>
