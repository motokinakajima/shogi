<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= schoolName %> - 管理ダッシュボード - KiNote</title>
    <link rel="stylesheet" href="/stylesheets/auth.css">
    <style>
        body {
            background: #ffffff;
            display: block;
            padding: 0;
        }
        
        .school-header {
            background: #4D5D70;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .school-header .logo {
            font-size: 32px;
            color: #FFE498;
            letter-spacing: 2px;
        }
        
        .school-header h1 {
            font-size: 20px;
            color: #ffffff;
            font-weight: 400;
            margin: 0;
        }
        
        .school-header .subtitle {
            font-size: 14px;
            color: rgba(255,255,255,0.7);
            margin: 4px 0 0 0;
        }
        
        .school-actions {
            display: flex;
            gap: 12px;
        }
        
        .school-actions .btn {
            width: auto;
            padding: 10px 20px;
            font-size: 16px;
            margin: 0;
        }
        
        .dashboard-content {
            padding: 32px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .students-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #000000;
        }
        
        .students-table th,
        .students-table td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(0,0,0,0.3);
            border-right: 1px solid rgba(0,0,0,0.3);
        }
        
        .students-table th:last-child,
        .students-table td:last-child {
            border-right: none;
        }
        
        .students-table th {
            background: #D9D9D9;
            font-weight: 600;
            color: #333;
            font-size: 14px;
        }
        
        .students-table tbody tr:hover {
            background: #f8f9fa;
        }
        
        .students-table select {
            padding: 6px 10px;
            border: 1px solid #000000;
            font-family: inherit;
            font-size: 14px;
            background: white;
        }
    </style>
</head>
<body>
    <div class="school-header">
        <div>
            <div class="logo">KiNote</div>
            <h1><%= schoolName %></h1>
            <p class="subtitle">学校管理ダッシュボード</p>
        </div>
        <div class="school-actions">
            <a href="/school-admin/register-student" class="btn btn-secondary">新規生徒登録</a>
            <form action="/school-admin/logout" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-primary">ログアウト</button>
            </form>
        </div>
    </div>
    
    <div class="dashboard-content">
        <div class="stats-summary">
            <div class="stat-card">
                <h3>登録生徒数</h3>
                <div class="value"><%= students.length %></div>
            </div>
            <div class="stat-card">
                <h3>平均レーティング</h3>
                <div class="value">
                    <%= students.length > 0 ? Math.round(students.reduce((sum, s) => sum + s.rating, 0) / students.length) : 1500 %>
                </div>
            </div>
        </div>
        
        <div class="section">
            <div class="section-header">
                <h2>生徒一覧</h2>
            </div>
            
            <% if (students.length === 0) { %>
                <div class="empty-state">
                    <p>まだ生徒が登録されていません</p>
                    <a href="/school-admin/register-student" class="btn btn-primary" style="width: auto;">最初の生徒を登録</a>
                </div>
            <% } else { %>
                <table class="students-table">
                    <thead>
                        <tr>
                            <th>表示名</th>
                            <th>メールアドレス</th>
                            <th>学年</th>
                            <th>棋力</th>
                            <th>性別</th>
                            <th>レーティング</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                            <tr data-student-id="<%= student.id %>">
                                <td><%= student.display_name %></td>
                                <td><%= student.email_address %></td>
                                <td>
                                    <select class="student-field" data-field="grade" data-student-id="<%= student.id %>">
                                        <option value="">未設定</option>
                                        <option value="小1" <%= student.grade === '小1' ? 'selected' : '' %>>小1</option>
                                        <option value="小2" <%= student.grade === '小2' ? 'selected' : '' %>>小2</option>
                                        <option value="小3" <%= student.grade === '小3' ? 'selected' : '' %>>小3</option>
                                        <option value="小4" <%= student.grade === '小4' ? 'selected' : '' %>>小4</option>
                                        <option value="小5" <%= student.grade === '小5' ? 'selected' : '' %>>小5</option>
                                        <option value="小6" <%= student.grade === '小6' ? 'selected' : '' %>>小6</option>
                                        <option value="中1" <%= student.grade === '中1' ? 'selected' : '' %>>中1</option>
                                        <option value="中2" <%= student.grade === '中2' ? 'selected' : '' %>>中2</option>
                                        <option value="中3" <%= student.grade === '中3' ? 'selected' : '' %>>中3</option>
                                        <option value="高1" <%= student.grade === '高1' ? 'selected' : '' %>>高1</option>
                                        <option value="高2" <%= student.grade === '高2' ? 'selected' : '' %>>高2</option>
                                        <option value="高3" <%= student.grade === '高3' ? 'selected' : '' %>>高3</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="student-field" data-field="skill_level" data-student-id="<%= student.id %>">
                                        <option value="">未設定</option>
                                        <option value="初心者" <%= student.skill_level === '初心者' ? 'selected' : '' %>>初心者</option>
                                        <option value="初級" <%= student.skill_level === '初級' ? 'selected' : '' %>>初級</option>
                                        <option value="中級" <%= student.skill_level === '中級' ? 'selected' : '' %>>中級</option>
                                        <option value="上級" <%= student.skill_level === '上級' ? 'selected' : '' %>>上級</option>
                                        <option value="有段者" <%= student.skill_level === '有段者' ? 'selected' : '' %>>有段者</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="student-field" data-field="gender" data-student-id="<%= student.id %>">
                                        <option value="">未設定</option>
                                        <option value="男性" <%= student.gender === '男性' ? 'selected' : '' %>>男性</option>
                                        <option value="女性" <%= student.gender === '女性' ? 'selected' : '' %>>女性</option>
                                        <option value="その他" <%= student.gender === 'その他' ? 'selected' : '' %>>その他</option>
                                    </select>
                                </td>
                                <td><%= student.rating %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
    
    <script>
        document.querySelectorAll('.student-field').forEach(select => {
            select.addEventListener('change', async function() {
                const studentId = this.dataset.studentId;
                const field = this.dataset.field;
                const value = this.value;
                
                const originalBg = this.style.background;
                this.style.background = '#fff8e1';
                this.disabled = true;
                
                try {
                    const response = await fetch('/api/school/update-student', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ studentId, field, value })
                    });
                    
                    const result = await response.json();
                    
                    if (response.ok) {
                        this.style.background = '#e8f5e9';
                        setTimeout(() => { this.style.background = originalBg; }, 1000);
                    } else {
                        alert('更新に失敗しました: ' + (result.error || 'Unknown error'));
                        this.style.background = '#ffebee';
                        setTimeout(() => { this.style.background = originalBg; }, 1000);
                    }
                } catch (error) {
                    console.error('Update failed:', error);
                    alert('更新に失敗しました');
                    this.style.background = '#ffebee';
                    setTimeout(() => { this.style.background = originalBg; }, 1000);
                } finally {
                    this.disabled = false;
                }
            });
        });
    </script>
</body>
</html>
