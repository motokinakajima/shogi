<div class="page">
    <div class="description">
        <h1>棋譜データベース</h1>
        <p>過去の対局棋譜を検索・閲覧できます</p>
    </div>

    <% if (games.length === 0) { %>
    <div class="section" style="text-align: center;">
        <p style="color: #7f8c8d;">まだ対局記録がありません</p>
    </div>
<% } else { %>
    <table class="list">
        <thead>
            <tr>
                <th>日時</th>
                <th>先手</th>
                <th>後手</th>
                <th>結果</th>
                <th>終局理由</th>
                <th>状態</th>
            </tr>
        </thead>
        <tbody>
            <% games.forEach(game => { %>
                <tr style="cursor: pointer;" onclick="location.href='/kifu/<%= game.id %>'">
                    <td><%= new Date(game.created_at).toLocaleString('ja-JP') %></td>
                    <td><%= game.sente?.display_name || '不明' %></td>
                    <td><%= game.gote?.display_name || '不明' %></td>
                    <td><%= game.is_finished ? (game.winner === 'sente' ? '先手勝ち' : '後手勝ち') : '-' %></td>
                    <td><%= game.is_finished ? (game.finish_reason === 'checkmate' ? '詰み' : game.finish_reason) : '-' %></td>
                    <td><%= game.is_finished ? '終了' : '進行中' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } %>
</div>
