<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>棋譜閲覧 - <%= game.sente_name %> vs <%= game.gote_name %></title>
    <link rel="stylesheet" href="/stylesheets/game.css">
    <style>
        body {
            margin-left: 240px;
            padding: 0;
        }
        
        .game-header {
            margin: 0;
            padding: 15px 20px;
        }
        
        #kifu-controls {
            text-align: center;
            margin: 20px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }
        
        #kifu-controls .button-group {
            display: flex;
            gap: 10px;
        }
        
        #kifu-controls button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            background: #3498db;
            color: white;
            border: none;
            border-radius: 4px;
        }
        
        #kifu-controls button:hover:not(:disabled) {
            background: #2980b9;
        }
        
        #kifu-controls button:disabled {
            background: #bdc3c7;
            cursor: not-allowed;
        }
        
        #move-slider {
            width: 500px;
            max-width: 90%;
        }
        
        #move-info {
            font-size: 18px;
            font-weight: bold;
            color: #2c3e50;
        }
        
        .game-info {
            text-align: center;
            margin: 20px 0;
            font-size: 14px;
            color: #7f8c8d;
        }
        
        #game-container {
            display: flex;
            gap: 20px;
            justify-content: center;
            align-items: flex-start;
        }
        
        #timer-display {
            display: none;
        }
        
        #controls {
            display: none;
        }
    </style>
</head>
<body>
    <div class="game-header">
        <a href="/database" class="back-button">← 棋譜データベースに戻る</a>
        <h2 style="margin: 0; color: #2c3e50;">棋譜閲覧</h2>
        <div style="width: 180px;"></div>
    </div>
    <div class="game-info" style="padding: 20px;">
        <p>
            <strong><%= game.sente_name %></strong> (先手) vs <strong><%= game.gote_name %></strong> (後手)<br>
            結果: <%= game.winner === 'sente' ? '先手勝ち' : '後手勝ち' %> 
            (<%= game.finish_reason === 'checkmate' ? '詰み' : game.finish_reason %>)<br>
            対局日時: <%= new Date(game.created_at).toLocaleString('ja-JP') %>
        </p>
    </div>

    <div id="kifu-controls">
        <div id="move-info">初期局面</div>
        <div class="button-group">
            <button id="firstBtn">⏮ 最初</button>
            <button id="prevBtn">◀ 前へ</button>
            <button id="playBtn">▶ 再生</button>
            <button id="nextBtn">次へ ▶</button>
            <button id="lastBtn">最後 ⏭</button>
        </div>
        <input type="range" id="move-slider" min="0" max="0" value="0">
    </div>

    <div id="game-container">
        <div class="captured-section" id="left-captured">
            <h4 id="left-label">後手 持ち駒</h4>
            <div id="left-pieces"></div>
        </div>
        <table id="board"></table>
        <div class="captured-section" id="right-captured">
            <h4 id="right-label">先手 持ち駒</h4>
            <div id="right-pieces"></div>
        </div>
    </div>

    <script>
        const gameId = '<%= game.id %>';
    </script>
    <script type="module" src="/javascripts/kifu-viewer.js"></script>
</body>
</html>
