<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新規登録 - KiNote</title>
    <link rel="stylesheet" href="/stylesheets/auth.css">
</head>
<body>
    <div class="container">
        <div class="header">KiNote</div>
        <div class="form-body">
            <h1>新規登録</h1>
            
            <div class="info-box">
                メンバー登録に記入したメールアドレスを入力してください。<br>
                ログイン時のパスワード設定リンクがご自身のメールアドレスに送られます。
            </div>
            
            <div id="message" class="success-message" style="display: none;"></div>
            <div id="error" class="error-message" style="display: none;"></div>
            
            <form id="registerForm">
                <div class="form-group">
                    <label for="email">メールアドレス</label>
                    <input type="email" id="email" name="email" required placeholder="学校に登録したメールアドレス">
                </div>
                <button type="submit" id="submitBtn" class="btn btn-primary">パスワード設定リンクを送信</button>
            </form>
            
            <div class="links">
                <a href="/login">← ログイン画面に戻る</a>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('registerForm');
        const messageDiv = document.getElementById('message');
        const errorDiv = document.getElementById('error');
        const submitBtn = document.getElementById('submitBtn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const email = document.getElementById('email').value;
            submitBtn.disabled = true;
            submitBtn.textContent = '送信中...';
            messageDiv.style.display = 'none';
            errorDiv.style.display = 'none';

            try {
                const response = await fetch('/login/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const data = await response.json();

                if (response.ok) {
                    messageDiv.textContent = data.message;
                    messageDiv.style.display = 'block';
                    form.reset();
                } else {
                    errorDiv.textContent = data.error || 'エラーが発生しました';
                    errorDiv.style.display = 'block';
                }
            } catch (error) {
                errorDiv.textContent = 'エラーが発生しました';
                errorDiv.style.display = 'block';
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'パスワード設定リンクを送信';
            }
        });
    </script>
</body>
</html>